rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow Kalakriti registrations & activity updates
    match /kalakriti/{document=**} {
      allow read, write: if true;
    }

    // Allow Ganpati Prasad Aarti slot bookings
    match /prasad_slots/{document=**} {
      allow read, write: if true;
    }

    // Allow Society Contributions & Payments
    match /contributions/{document=**} {
      allow read, write: if true;
    }

    // Allow Maha Prasad RSVPs & Headcount Tracking (Real-time)
    match /maha_prasad_rsvps/{document=**} {
      allow read, write: if true;
    }
    match /maha_prasad_rsvp/{document=**} {
      allow read, write: if true;
    }

    // Allow Society Expenses & Approvals
    match /expenses/{document=**} {
      allow read, write: if true;
    }

    // Allow Budgets & Financial Planning
    match /budgets/{document=**} {
      allow read, write: if true;
    }

    // Allow Other Incomes / Sponsorships
    match /other_income/{document=**} {
      allow read, write: if true;
    }

    // Allow Admin Login Audit & Device Tracking
    match /admin_login_logs/{document=**} {
      allow read, write: if true;
    }

    // Allow Live Active Sessions / Concurrent Visitors Tracking
    match /active_sessions/{document=**} {
      allow read, write: if true;
    }

    // Portal settings & security credentials
    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

